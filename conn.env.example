# Database Configuration
# Local file-based configuration for Lance Code Studio API.
#
# HOW TO USE:
#   1. Copy this file to conn.env
#   2. Fill in real values (never commit conn.env — it is in .gitignore)
#
# Runtime precedence:
# 1. Environment variables
# 2. conn.env file (this file)
#
# File format rules:
# - One KEY=VALUE per line
# - Do not wrap values in quotes
# - Lines starting with # are comments


# SQLite Configuration
# Use a relative path (relative to the app's base directory) so it works
# cross-platform and in deployment without changes.
DB_FILE_PATH=pharmacy.db
DB_PASSWORD=
DB_PROTECTED_SQLITE=false



# JWT Configuration
# Generate a strong random key (32+ bytes, hex or base64 encoded).
# Example (PowerShell): -join (1..32 | % { '{0:X2}' -f (Get-Random -Maximum 256) })
# Example (bash):       openssl rand -hex 32
Jwt__Key=your-secret-jwt-key-here-replace-with-a-real-random-value
